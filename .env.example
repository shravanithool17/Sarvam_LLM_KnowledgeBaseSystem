# ============================================================
# AI Knowledge Engineering Platform v2.0 — Environment Config
# Copy this file to .env and fill in your values.
# All values below are the defaults used when not set.
# ============================================================

# ─── Sarvam AI ───────────────────────────────────────────────
# Your Sarvam AI API subscription key (get from dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Model identifier — verified valid models (Nov 2025):
#   sarvam-105b               — 128K context, complex reasoning (recommended)
#   sarvam-105b-conversations  — 32K context, conversational workloads
# NOTE: sarvam-30b and sarvam-2b are NOT valid model identifiers.
SARVAM_MODEL=sarvam-105b

# Sarvam API endpoint (do not change unless instructed)
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions

# Request timeout in seconds
SARVAM_TIMEOUT=90

# Maximum number of retry attempts for transient API errors
SARVAM_MAX_RETRIES=2

# ─── Document Processing ─────────────────────────────────────
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Default chunk size in characters
DEFAULT_CHUNK_SIZE=600

# Default overlap in characters (composed of whole sentences)
DEFAULT_OVERLAP=100

# Minimum chunk length — shorter chunks are discarded
MIN_CHUNK_LENGTH=50

# Number of chunks per synthesis batch (map-reduce batch size)
SYNTHESIS_BATCH_SIZE=3

# Default number of facts per synthesis batch
DEFAULT_NUM_FACTS=3

# Default number of QA pairs per synthesis batch
DEFAULT_NUM_QA_PAIRS=3

# ─── RAG Retrieval ───────────────────────────────────────────
# Default number of top-k chunks to retrieve
DEFAULT_TOP_K=2

# Minimum relevance score (0.0–100.0) to include in RAG results
RAG_MIN_SCORE=0.0

# ─── Quality Evaluation ──────────────────────────────────────
# Jaccard similarity threshold for flagging duplicate chunks
SIMILARITY_THRESHOLD=0.45

# ─── Persistent Storage ──────────────────────────────────────
# Directory for SQLite database and JSON result files
STORAGE_DIR=./data/

# ─── Server ──────────────────────────────────────────────────
# Environment mode: development | production
# In development: CORS wildcard (*) is allowed, CSP is permissive
# In production: set ALLOWED_ORIGINS explicitly
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
# Leave blank in development (defaults to wildcard)
# Required in production: e.g. https://myapp.com,https://admin.myapp.com
ALLOWED_ORIGINS=
